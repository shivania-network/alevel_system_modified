# Copy this file to email_settings.env, then fill in your real sender account.
# Do not share email_settings.env because it contains a private password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-school-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-school-email@gmail.com
SMTP_USE_TLS=true
APP_PUBLIC_URL=http://127.0.0.1:5000
