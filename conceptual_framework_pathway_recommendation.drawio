        <mxCell id="system_title" value="&lt;b&gt;How the system works / recommendation process&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="95" width="380" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;1. Data preparation&lt;/b&gt;&lt;br&gt;Convert letter grades to numbers and scale the data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="380" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;2. Calculate subject-group averages&lt;/b&gt;&lt;br&gt;Science, humanities, languages, technical, business, and overall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="280" width="380" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;3. Random Forest prediction&lt;/b&gt;&lt;br&gt;Predict the most suitable pathway for the student" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="380" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;4. Adjust using student preferences&lt;/b&gt;&lt;br&gt;Final ranking considers both grades and personal choices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="380" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;5. Display recommendation&lt;/b&gt;&lt;br&gt;Show ranked pathways and print-ready result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="580" width="380" height="65" as="geometry"/>
        </mxCell>

