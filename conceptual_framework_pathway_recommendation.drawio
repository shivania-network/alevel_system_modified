        <mxCell id="dep_header" value="&lt;b&gt;Dependent variable&lt;/b&gt;&lt;br&gt;Recommended A-Level pathway&lt;br&gt;(ranked from most to least suitable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
